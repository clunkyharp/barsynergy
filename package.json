{
  "name": "barsynergy",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "./node_modules/.bin/next dev",
    "build": "./node_modules/.bin/prisma generate && ./node_modules/.bin/next build && node ./scripts/sync-standalone-assets.mjs && node ./scripts/verify-standalone-runtime.mjs",
    "start": "./node_modules/.bin/next start",
    "admin:upsert:local": "node ./scripts/upsert-local-admin.mjs",
    "accounts:reset:local": "node ./scripts/reset-local-accounts.mjs",
    "auth:cleanup:throttles": "node ./scripts/cleanup-auth-attempt-throttles.mjs",
    "business-access:cleanup:invites": "node ./scripts/cleanup-business-access-invites.mjs",
    "lint": "./node_modules/.bin/eslint .",
    "playwright": "./node_modules/.bin/playwright test",
    "screenshots:public": "node ./scripts/capture-public-screenshots.mjs",
    "playwright:install": "./node_modules/.bin/playwright install chromium",
    "playwright:report": "./node_modules/.bin/playwright show-report test-results/html-report",
    "playwright:ui": "./node_modules/.bin/playwright test --ui",
    "qa:browser": "./node_modules/.bin/playwright test",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "./node_modules/.bin/next typegen && ./node_modules/.bin/tsc --noEmit",
    "application:cleanup:throttles": "node ./scripts/cleanup-application-throttles.mjs",
    "notifications:retry": "node --experimental-strip-types ./scripts/retry-application-notifications.ts",
    "notifications:content:retry": "node --experimental-strip-types ./scripts/retry-content-notifications.ts",
    "demo:seed:screens": "node ./scripts/seed-demo-screens.mjs",
    "session:cleanup:expired": "node ./scripts/cleanup-expired-sessions.mjs",
    "prisma:generate": "./node_modules/.bin/prisma generate",
    "prisma:migrate:dev": "./node_modules/.bin/prisma migrate dev",
    "prisma:migrate:deploy": "./node_modules/.bin/prisma migrate deploy",
    "prisma:studio": "./node_modules/.bin/prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1037.0",
    "@gsap/react": "2.1.2",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "gsap": "3.15.0",
    "lucide-react": "1.11.0",
    "next": "16.2.6",
    "nodemailer": "8.0.7",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.5.0",
    "web-push": "3.6.7",
    "zod": "4.3.6"
  },
  "description": "BARSYNERGY fullstack web platform foundation on Next.js, PostgreSQL and Prisma.",
  "main": "index.js",
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@tailwindcss/postcss": "4.2.4",
    "@types/node": "24.12.2",
    "@types/nodemailer": "8.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "3.6.4",
    "axe-core": "4.11.4",
    "eslint": "9.39.4",
    "postcss": "8.5.14",
    "prisma": "6.19.3",
    "tailwindcss": "4.2.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.0"
  },
  "overrides": {
    "postcss": "8.5.14",
    "fast-xml-builder": "1.2.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
