generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER      @map("user")
  BUSINESS  @map("business")
  MODERATOR @map("moderator")
  ADMIN     @map("admin")
}

enum UserStatus {
  ACTIVE  @map("active")
  BLOCKED @map("blocked")
  PENDING @map("pending")
}

enum JobSearchStatus {
  ACTIVE      @map("active")
  OPEN        @map("open")
  NOT_LOOKING @map("not_looking")
}

enum EmploymentType {
  FULL_TIME  @map("full_time")
  PART_TIME  @map("part_time")
  FREELANCE  @map("freelance")
  REMOTE     @map("remote")
}

enum BusinessAccountStatus {
  PENDING  @map("pending")
  ACTIVE   @map("active")
  BLOCKED  @map("blocked")
  ARCHIVED @map("archived")
}

enum CategoryType {
  ARTICLE  @map("article")
  EVENT    @map("event")
  COURSE   @map("course")
  VACANCY  @map("vacancy")
  SUPPLIER @map("supplier")
  PARTNER  @map("partner")
  SERVICE  @map("service")
  GENERAL  @map("general")
}

enum StorageDriver {
  LOCAL @map("local")
  S3    @map("s3")
}

enum FileVisibility {
  PUBLIC  @map("public")
  PRIVATE @map("private")
}

enum ContentStatus {
  DRAFT     @map("draft")
  REVIEW    @map("review")
  PUBLISHED @map("published")
  ARCHIVED  @map("archived")
}

enum ApplicationType {
  BUSINESS_ACCOUNT_REQUEST       @map("business_account_request")
  COURSE_APPLICATION             @map("course_application")
  EVENT_APPLICATION              @map("event_application")
  VACANCY_SUBMISSION             @map("vacancy_submission")
  VACANCY_RESPONSE               @map("vacancy_response")
  SUPPLIER_SUBMISSION            @map("supplier_submission")
  PARTNER_APPLICATION            @map("partner_application")
  BUSINESS_SOLUTION              @map("business_solution")
  CONSULTING_REQUEST             @map("consulting_request")
  CONTACT_MESSAGE                @map("contact_message")
  CORPORATE_TRAINING_APPLICATION @map("corporate_training_application")
  CERTIFICATE_ORDER              @map("certificate_order")
  SUPPLIER_INQUIRY               @map("supplier_inquiry")
}

enum ApplicationStatus {
  DRAFT                 @map("draft")
  NEW                   @map("new")
  IN_REVIEW             @map("in_review")
  CONTACTED             @map("contacted")
  FORWARDED_TO_EMPLOYER @map("forwarded_to_employer")
  PAYMENT_PENDING       @map("payment_pending")
  PAID_MANUALLY         @map("paid_manually")
  APPROVED              @map("approved")
  REJECTED              @map("rejected")
  COMPLETED             @map("completed")
  ARCHIVED              @map("archived")
}

enum ApplicationNotificationChannel {
  ADMIN_EMAIL              @map("admin_email")
  ADMIN_TELEGRAM           @map("admin_telegram")
  USER_EMAIL               @map("user_email")
  BUSINESS_MESSAGE_EMAIL   @map("business_message_email")
  USER_MESSAGE_EMAIL       @map("user_message_email")
}

enum ConversationSender {
  USER     @map("user")
  BUSINESS @map("business")
  ADMIN    @map("admin")

  @@map("ConversationSender")
}

enum ApplicationNotificationStatus {
  PENDING @map("pending")
  SENT    @map("sent")
  FAILED  @map("failed")

  @@map("ApplicationNotificationStatus")
}

enum AuthNotificationType {
  USER_VERIFY_EMAIL       @map("user_verify_email")
  USER_PASSWORD_RESET     @map("user_password_reset")
  BUSINESS_PASSWORD_RESET @map("business_password_reset")

  @@map("AuthNotificationType")
}

enum AuthNotificationStatus {
  PENDING @map("pending")
  SENT    @map("sent")
  FAILED  @map("failed")

  @@map("AuthNotificationStatus")
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String
  role            UserRole   @default(USER)
  status          UserStatus @default(PENDING)
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  profile                 Profile?
  sessions                Session[]
  businessAccount         BusinessAccount?
  uploadedFiles           UploadedFile[]
  savedVacancies          SavedVacancy[]
  emailVerificationTokens UserEmailVerificationToken[]
  passwordResetTokens     UserPasswordResetToken[]
  authNotifications       AuthNotification[]
  createdArticles         Article[]                    @relation("ArticleCreatedBy")
  updatedArticles         Article[]                    @relation("ArticleUpdatedBy")
  createdEvents           Event[]                      @relation("EventCreatedBy")
  updatedEvents           Event[]                      @relation("EventUpdatedBy")
  createdCourses          Course[]                     @relation("CourseCreatedBy")
  updatedCourses          Course[]                     @relation("CourseUpdatedBy")
  createdVacancies        Vacancy[]                    @relation("VacancyCreatedBy")
  updatedVacancies        Vacancy[]                    @relation("VacancyUpdatedBy")
  createdSuppliers        Supplier[]                   @relation("SupplierCreatedBy")
  updatedSuppliers        Supplier[]                   @relation("SupplierUpdatedBy")
  createdPartners         Partner[]                    @relation("PartnerCreatedBy")
  updatedPartners         Partner[]                    @relation("PartnerUpdatedBy")
  createdGeneralSponsors  GeneralSponsor[]             @relation("GeneralSponsorCreatedBy")
  updatedGeneralSponsors  GeneralSponsor[]             @relation("GeneralSponsorUpdatedBy")
  applications            Application[]                @relation("ApplicationUser")
  forwardedApplications   Application[]                @relation("ApplicationForwardedBy")
  businessAccessInvites   BusinessAccessInvite[]
  conversationMessages    ConversationMessage[]

  @@index([role])
  @@index([status])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Profile {
  id               String           @id @default(cuid())
  userId           String           @unique
  fullName         String?
  cityId           String?
  profession       String?
  company          String?
  bio              String?
  phone            String?
  telegram         String?
  website          String?
  avatarFileId     String?   @unique
  jobSearchStatus  JobSearchStatus?
  desiredSalary    Int?
  desiredSalaryMax Int?
  employmentTypes  EmploymentType[]
  skills           String[]
  isPublic         Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  city           City?             @relation(fields: [cityId], references: [id], onDelete: SetNull)
  avatarFile     UploadedFile?     @relation("ProfileAvatarFile", fields: [avatarFileId], references: [id], onDelete: SetNull)
  workExperiences WorkExperience[]
  profileSkills   ProfileSkill[]

  @@index([cityId])
  @@index([isPublic, jobSearchStatus])
}

model WorkExperience {
  id          String   @id @default(cuid())
  profileId   String
  companyName String
  position    String
  startDate   DateTime
  endDate     DateTime?
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, sortOrder])
}

model Skill {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profileSkills ProfileSkill[]

  @@index([isActive, sortOrder])
}

model ProfileSkill {
  profileId String
  skillId   String
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([profileId, skillId])
  @@index([skillId])
}

model SavedVacancy {
  id        String   @id @default(cuid())
  userId    String
  vacancyId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vacancy Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  @@unique([userId, vacancyId])
  @@index([userId])
}

model BusinessAccount {
  id            String                @id @default(cuid())
  ownerId       String                @unique
  companyName   String
  slug          String                @unique
  status        BusinessAccountStatus @default(PENDING)
  cityId        String?
  contactPerson String?
  phone         String?
  telegram      String?
  websiteUrl    String?
  description   String?
  adminNotes    String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  city         City?         @relation(fields: [cityId], references: [id], onDelete: SetNull)
  applications Application[]
  vacancies    Vacancy[]

  @@index([status, createdAt])
  @@index([cityId, status])
  @@index([companyName])
}

model City {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  region    String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profiles         Profile[]
  businessAccounts BusinessAccount[]
  articles         Article[]
  events           Event[]
  courses          Course[]
  vacancies        Vacancy[]
  suppliers        Supplier[]
  generalSponsors  GeneralSponsor[]
  applications     Application[]

  @@index([isActive, sortOrder])
}

model Category {
  id          String       @id @default(cuid())
  name        String
  slug        String
  type        CategoryType
  description String?
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  articles  Article[]
  events    Event[]
  courses   Course[]
  vacancies Vacancy[]
  suppliers Supplier[]
  partners  Partner[]

  @@unique([slug, type])
  @@index([type, isActive, sortOrder])
}

model Tag {
  id          String       @id @default(cuid())
  name        String
  slug        String
  type        CategoryType
  description String?
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  articleTags ArticleTag[]

  @@unique([slug, type])
  @@index([type, isActive, sortOrder])
}

model UploadedFile {
  id            String         @id @default(cuid())
  storageDriver StorageDriver
  bucket        String?
  fileKey       String
  originalName  String
  mimeType      String
  size          Int
  visibility    FileVisibility
  uploadedById  String?
  createdAt     DateTime       @default(now())

  uploadedBy                User?            @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  articleCoverImages        Article[]        @relation("ArticleCoverImage")
  eventCoverImages          Event[]          @relation("EventCoverImage")
  courseCoverImages         Course[]         @relation("CourseCoverImage")
  vacancyCoverImages        Vacancy[]        @relation("VacancyCoverImage")
  supplierCoverImages       Supplier[]       @relation("SupplierCoverImage")
  partnerCoverImages        Partner[]        @relation("PartnerCoverImage")
  generalSponsorLogoImages  GeneralSponsor[] @relation("GeneralSponsorLogoImage")
  generalSponsorCoverImages GeneralSponsor[] @relation("GeneralSponsorCoverImage")
  profileAvatar             Profile?         @relation("ProfileAvatarFile")
  resumeApplications        Application[]    @relation("ApplicationResumeFile")

  @@index([fileKey])
  @@index([uploadedById])
  @@index([visibility])
}

model Article {
  id                 String        @id @default(cuid())
  title              String
  slug               String        @unique
  summary            String
  body               String
  status             ContentStatus @default(DRAFT)
  coverImageId       String?
  coverImageAlt      String?
  cityId             String?
  categoryId         String?
  sortOrder          Int           @default(0)
  publishedAt        DateTime?
  archivedAt         DateTime?
  createdById        String?
  updatedById        String?
  readingTimeMinutes Int?
  authorName         String?
  sourceLabel        String?
  sourceReferences   String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  coverImage UploadedFile? @relation("ArticleCoverImage", fields: [coverImageId], references: [id], onDelete: SetNull)
  city       City?         @relation(fields: [cityId], references: [id], onDelete: SetNull)
  category   Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy  User?         @relation("ArticleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy  User?         @relation("ArticleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  tags       ArticleTag[]

  @@index([status, publishedAt])
  @@index([cityId, status])
  @@index([categoryId, status])
  @@index([sortOrder])
}

model ArticleTag {
  articleId String
  tagId     String
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

model Event {
  id               String        @id @default(cuid())
  title            String
  slug             String        @unique
  summary          String
  status           ContentStatus @default(DRAFT)
  coverImageId     String?
  coverImageAlt    String?
  cityId           String?
  categoryId       String?
  sortOrder        Int           @default(0)
  publishedAt      DateTime?
  archivedAt       DateTime?
  createdById      String?
  updatedById      String?
  startsAt         DateTime
  endsAt           DateTime?
  locationName     String?
  address          String?
  format           String?
  capacity         Int?
  registrationMode String?
  registrationUrl  String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  coverImage UploadedFile? @relation("EventCoverImage", fields: [coverImageId], references: [id], onDelete: SetNull)
  city       City?         @relation(fields: [cityId], references: [id], onDelete: SetNull)
  category   Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy  User?         @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy  User?         @relation("EventUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([cityId, status])
  @@index([categoryId, status])
  @@index([startsAt])
  @@index([sortOrder])
}

model Course {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  summary        String
  status         ContentStatus @default(DRAFT)
  coverImageId   String?
  coverImageAlt  String?
  cityId         String?
  categoryId     String?
  sortOrder      Int           @default(0)
  publishedAt    DateTime?
  archivedAt     DateTime?
  createdById    String?
  updatedById    String?
  format         String?
  durationLabel  String?
  level          String?
  priceLabel     String?
  instructorName String?
  program        String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  coverImage UploadedFile? @relation("CourseCoverImage", fields: [coverImageId], references: [id], onDelete: SetNull)
  city       City?         @relation(fields: [cityId], references: [id], onDelete: SetNull)
  category   Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy  User?         @relation("CourseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy  User?         @relation("CourseUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([cityId, status])
  @@index([categoryId, status])
  @@index([sortOrder])
}

model Vacancy {
  id                String        @id @default(cuid())
  title             String
  slug              String        @unique
  summary           String
  status            ContentStatus @default(DRAFT)
  coverImageId      String?
  coverImageAlt     String?
  cityId            String?
  categoryId        String?
  businessAccountId String?
  sortOrder         Int           @default(0)
  publishedAt       DateTime?
  archivedAt        DateTime?
  createdById       String?
  updatedById       String?
  companyName       String
  position          String
  employmentType    String?
  salaryLabel       String?
  experienceLabel   String?
  contactMode       String?
  description       String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  coverImage   UploadedFile?   @relation("VacancyCoverImage", fields: [coverImageId], references: [id], onDelete: SetNull)
  city         City?           @relation(fields: [cityId], references: [id], onDelete: SetNull)
  category     Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  businessAccount BusinessAccount? @relation(fields: [businessAccountId], references: [id], onDelete: SetNull)
  createdBy    User?           @relation("VacancyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?           @relation("VacancyUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  applications  Application[]
  savedVacancies SavedVacancy[]

  @@index([status, publishedAt])
  @@index([cityId, status])
  @@index([categoryId, status])
  @@index([businessAccountId])
  @@index([sortOrder])
}

model Supplier {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  summary       String
  status        ContentStatus @default(DRAFT)
  coverImageId  String?
  coverImageAlt String?
  cityId        String?
  categoryId    String?
  sortOrder     Int           @default(0)
  publishedAt   DateTime?
  archivedAt    DateTime?
  createdById   String?
  updatedById   String?
  companyName   String
  description   String
  websiteUrl    String?
  contactLabel  String?
  isVerified    Boolean       @default(false)
  serviceArea   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  coverImage   UploadedFile? @relation("SupplierCoverImage", fields: [coverImageId], references: [id], onDelete: SetNull)
  city         City?         @relation(fields: [cityId], references: [id], onDelete: SetNull)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation("SupplierCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?         @relation("SupplierUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  applications Application[]

  @@index([status, publishedAt])
  @@index([cityId, status])
  @@index([categoryId, status])
  @@index([isVerified, status])
  @@index([sortOrder])
}

model Partner {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  summary       String
  status        ContentStatus @default(DRAFT)
  coverImageId  String?
  coverImageAlt String?
  categoryId    String?
  sortOrder     Int           @default(0)
  publishedAt   DateTime?
  archivedAt    DateTime?
  createdById   String?
  updatedById   String?
  companyName   String
  description   String
  websiteUrl    String?
  partnerType   String?
  isFeatured    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  coverImage   UploadedFile? @relation("PartnerCoverImage", fields: [coverImageId], references: [id], onDelete: SetNull)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation("PartnerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?         @relation("PartnerUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  applications Application[]

  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@index([partnerType, status])
  @@index([isFeatured, status])
  @@index([sortOrder])
}

model GeneralSponsor {
  id                String        @id @default(cuid())
  name              String
  slug              String        @unique
  status            ContentStatus @default(DRAFT)
  logoImageId       String?
  logoImageAlt      String?
  logoPath          String?
  coverImageId      String?
  coverImageAlt     String?
  coverImagePath    String?
  shortDescription  String
  fullDescription   String
  seasonLabel       String?
  priority          Int           @default(0)
  isFeatured        Boolean       @default(false)
  websiteUrl        String?
  instagramUrl      String?
  whatsappUrl       String?
  telegramUrl       String?
  contactName       String?
  contactPhone      String?
  contactEmail      String?
  representedBrands String?
  benefitsForVenues String?
  cityId            String?
  publishedAt       DateTime?
  archivedAt        DateTime?
  createdById       String?
  updatedById       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  logoImage  UploadedFile? @relation("GeneralSponsorLogoImage", fields: [logoImageId], references: [id], onDelete: SetNull)
  coverImage UploadedFile? @relation("GeneralSponsorCoverImage", fields: [coverImageId], references: [id], onDelete: SetNull)
  city       City?         @relation(fields: [cityId], references: [id], onDelete: SetNull)
  createdBy  User?         @relation("GeneralSponsorCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy  User?         @relation("GeneralSponsorUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([cityId, status])
  @@index([isFeatured, status])
  @@index([priority])
}

model HomepageHero {
  id          String        @id @default(cuid())
  status      ContentStatus @default(DRAFT)
  eyebrow     String
  title       String
  description String
  signalsText String?
  priority    Int           @default(0)
  publishedAt DateTime?
  archivedAt  DateTime?
  createdById String?
  updatedById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, priority])
}

model HomepageAudienceCard {
  id          String        @id @default(cuid())
  status      ContentStatus @default(DRAFT)
  title       String
  description String
  href        String
  actionLabel String
  proof       String?
  imagePath   String?
  iconKey     String?
  priority    Int           @default(0)
  publishedAt DateTime?
  archivedAt  DateTime?
  createdById String?
  updatedById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, priority])
}

model HomepageSocialBlock {
  id          String        @id @default(cuid())
  status      ContentStatus @default(DRAFT)
  name        String
  title       String
  description String
  helperText  String?
  actionLabel String
  href        String
  logoPath    String?
  variant     String?
  priority    Int           @default(0)
  publishedAt DateTime?
  archivedAt  DateTime?
  createdById String?
  updatedById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, priority])
}

model HomepageCtaBlock {
  id             String        @id @default(cuid())
  status         ContentStatus @default(DRAFT)
  title          String
  description    String
  helperText     String?
  primaryLabel   String
  primaryHref    String
  secondaryLabel String?
  secondaryHref  String?
  priority       Int           @default(0)
  publishedAt    DateTime?
  archivedAt     DateTime?
  createdById    String?
  updatedById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, priority])
}

model HomepageCalculatorTeaser {
  id          String        @id @default(cuid())
  status      ContentStatus @default(DRAFT)
  eyebrow     String
  title       String
  cardEyebrow String
  cardTitle   String
  description String
  stepsText   String?
  actionLabel String
  actionHref  String
  priority    Int           @default(0)
  publishedAt DateTime?
  archivedAt  DateTime?
  createdById String?
  updatedById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, priority])
}

model Application {
  id                String            @id @default(cuid())
  type              ApplicationType
  status            ApplicationStatus @default(NEW)
  subject           String?
  message           String?
  name              String?
  email             String?
  phone             String?
  telegram          String?
  userId            String?
  cityId            String?
  vacancyId         String?
  businessAccountId String?
  supplierId        String?
  partnerId         String?
  resumeFileId      String?
  payload           Json?
  consentAcceptedAt DateTime?
  consentText       String?
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  forwardedAt       DateTime?
  forwardedById     String?
  internalNotes     String?
  businessNotes     String?
  hasUnreadForUser     Boolean   @default(false)
  hasUnreadForBusiness Boolean   @default(false)
  lastMessageAt     DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user                  User?                     @relation("ApplicationUser", fields: [userId], references: [id], onDelete: SetNull)
  city                  City?                     @relation(fields: [cityId], references: [id], onDelete: SetNull)
  vacancy               Vacancy?                  @relation(fields: [vacancyId], references: [id], onDelete: SetNull)
  businessAccount       BusinessAccount?          @relation(fields: [businessAccountId], references: [id], onDelete: SetNull)
  supplier              Supplier?                 @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  partner               Partner?                  @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  resumeFile            UploadedFile?             @relation("ApplicationResumeFile", fields: [resumeFileId], references: [id], onDelete: SetNull)
  forwardedBy           User?                     @relation("ApplicationForwardedBy", fields: [forwardedById], references: [id], onDelete: SetNull)
  businessAccessInvites BusinessAccessInvite[]
  notifications         ApplicationNotification[]
  conversationMessages  ConversationMessage[]

  @@index([type, status])
  @@index([status, createdAt])
  @@index([cityId, status])
  @@index([vacancyId, status])
  @@index([businessAccountId, status])
  @@index([supplierId, status])
  @@index([partnerId, status])
  @@index([userId, status])
  @@index([email])
  @@index([phone])
  @@index([createdAt])
}

model ApplicationNotification {
  id            String                         @id @default(cuid())
  applicationId String
  channel       ApplicationNotificationChannel
  status        ApplicationNotificationStatus  @default(PENDING)
  attempts      Int                            @default(0)
  nextAttemptAt DateTime                       @default(now())
  sentAt        DateTime?
  lastError     String?
  payload       Json
  createdAt     DateTime                       @default(now())
  updatedAt     DateTime                       @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([applicationId, channel])
}

model ConversationMessage {
  id                 String             @id @default(cuid())
  applicationId      String
  authorId           String?
  senderRole         ConversationSender
  body               String             @db.Text
  isReadByUser       Boolean            @default(false)
  isReadByBusiness   Boolean            @default(false)
  createdAt          DateTime           @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author      User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@index([authorId])
  @@index([applicationId, isReadByUser])
  @@index([applicationId, isReadByBusiness])
}

model UserEmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model UserPasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model AuthNotification {
  id            String                 @id @default(cuid())
  type          AuthNotificationType
  email         String
  userId        String?
  payload       Json
  status        AuthNotificationStatus @default(PENDING)
  attempts      Int                    @default(0)
  nextAttemptAt DateTime               @default(now())
  sentAt        DateTime?
  lastError     String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([status, nextAttemptAt])
}

model BusinessAccessInvite {
  id            String    @id @default(cuid())
  userId        String
  applicationId String
  tokenHash     String    @unique
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([applicationId])
  @@index([expiresAt])
  @@index([usedAt])
}

model ApplicationSubmissionThrottle {
  keyHash         String   @id
  windowStartedAt DateTime
  count           Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([windowStartedAt])
  @@index([updatedAt])
}

model AuthAttemptThrottle {
  keyHash         String   @id
  windowStartedAt DateTime
  count           Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([windowStartedAt])
  @@index([updatedAt])
}
